        isEducationAdmin() ||
        isAdmin()
      ) && incoming().id is string && incoming().id.size() <= 128
        && incoming().title is string && incoming().title.size() >= 2 && incoming().title.size() <= 300
        && incoming().reviewStatus in ['Pending Review', 'Approved', 'Imported', 'Rejected', 'Duplicate', 'Failed'];
      allow delete: if isValidId(id) && (isContentAdmin() || isEducationAdmin() || isSuperAdmin());
    }

    match /discovery_jobs/{id} {
      allow get, list: if isContentAdmin() || isEducationAdmin() || isAdmin();
      allow create, update: if isValidId(id) && (
