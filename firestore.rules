rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user is Super Admin or root administrator
    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && (
          request.auth.token.email == 'akashrajnayak@gmail.com' ||
          request.auth.token.email == 'admin@openframeitsolutions.com'
        )) ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'Super Admin' &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isActive == true)
      );
    }

    // Check if user is any authenticated active Admin
    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isActive == true
      );
    }

    // Role-specific helpers
    function hasRole(role) {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isActive == true &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == role
      );
    }

    function isHRAdmin() {
      return hasRole('HR Admin');
    }

    function isSalesAdmin() {
      return hasRole('Sales Admin');
    }

    function isEducationAdmin() {
      return hasRole('Education Admin');
    }

    function isHopeNestAdmin() {
      return hasRole('HopeNest Admin');
    }

    function isContentAdmin() {
      return hasRole('Content Admin');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ====================================================
    // Validation Helpers
    // ====================================================

    function isValidContactMessage(data) {
      return data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.emailAddress is string && data.emailAddress.size() <= 120 &&
             data.message is string && data.message.size() >= 5 && data.message.size() <= 2500 &&
             data.submittedAt is string && data.submittedAt.size() <= 40;
    }

    function isValidGeneralEnquiry(data) {
      return data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.emailAddress is string && data.emailAddress.size() <= 120 &&
             data.mobileNumber is string && data.mobileNumber.size() <= 25 &&
             data.city is string && data.city.size() <= 80 &&
             data.state is string && data.state.size() <= 80 &&
             data.subject is string && data.subject.size() <= 200 &&
             data.message is string && data.message.size() >= 5 && data.message.size() <= 2500 &&
             data.consentAccepted == true &&
             data.submittedAt is string && data.submittedAt.size() <= 40;
    }

    function isValidSoftwareEnquiry(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.emailAddress is string && data.emailAddress.size() <= 120 &&
             data.mobileNumber is string && data.mobileNumber.size() <= 25 &&
             data.requiredService is string && data.requiredService.size() <= 100 &&
             data.projectDescription is string && data.projectDescription.size() >= 5 && data.projectDescription.size() <= 3500 &&
             data.submittedAt is string && data.submittedAt.size() <= 40;
    }

    function isValidBusinessEnquiry(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.organisation is string && data.organisation.size() <= 120 &&
             data.emailAddress is string && data.emailAddress.size() <= 120 &&
             data.mobileNumber is string && data.mobileNumber.size() <= 25 &&
             data.businessRequirement is string && data.businessRequirement.size() <= 150 &&
             data.message is string && data.message.size() >= 5 && data.message.size() <= 3500 &&
             data.submittedAt is string && data.submittedAt.size() <= 40;
    }

    function isValidProductEnquiry(data) {
      return data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.emailAddress is string && data.emailAddress.size() <= 120 &&
             data.mobileNumber is string && data.mobileNumber.size() <= 25 &&
             data.productName is string && data.productName.size() <= 100 &&
             data.message is string && data.message.size() <= 2500 &&
             data.consentAccepted == true &&
             data.submittedAt is string && data.submittedAt.size() <= 40;
    }

    function isValidSubscriber(data) {
      return data.emailAddress is string && data.emailAddress.size() <= 120 &&
             data.consentAccepted == true &&
             data.subscribedAt is string && data.subscribedAt.size() <= 40;
    }

    function isValidBranch(data) {
      return data.name is string && data.name.size() <= 120 &&
             data.city is string && data.city.size() <= 80 &&
             data.state is string && data.state.size() <= 80 &&
             data.fullAddress is string && data.fullAddress.size() <= 300 &&
             data.contactNumber is string && data.contactNumber.size() <= 40 &&
             data.email is string && data.email.size() <= 100 &&
             data.officeHours is string && data.officeHours.size() <= 100 &&
             data.isActive is bool;
    }

    function isValidCourse(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 300 &&
             data.category is string && data.category.size() <= 120 &&
             data.price is number && data.price >= 0;
    }

    // ====================================================
    // Enquiries Collections (RBAC: Sales Admin, Super Admin)
    // ====================================================

    match /contact_messages/{id} {
      allow create: if isValidId(id) && isValidContactMessage(incoming());
      allow read, update, delete: if isSalesAdmin();
    }

    match /general_enquiries/{id} {
      allow create: if isValidId(id) && isValidGeneralEnquiry(incoming());
      allow read, update, delete: if isSalesAdmin();
    }

    match /software_enquiries/{id} {
      allow create: if isValidId(id) && isValidSoftwareEnquiry(incoming());
      allow read, update, delete: if isSalesAdmin();
    }

    match /business_enquiries/{id} {
      allow create: if isValidId(id) && isValidBusinessEnquiry(incoming());
      allow read, update, delete: if isSalesAdmin();
    }

    match /product_enquiries/{id} {
      allow create: if isValidId(id) && isValidProductEnquiry(incoming());
      allow read, update, delete: if isSalesAdmin();
    }

    // ====================================================
    // LMS Role Helpers (Verified DB Lookups)
    function isLmsTeacher() {
      return isEducationAdmin() || isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
      );
    }

    function isLmsEducatorOrAdmin() {
      return isLmsTeacher() || isEducationAdmin() || isAdmin();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isLinkedParent(studentUid) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/parent_links/$(request.auth.uid + '_' + studentUid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         studentUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudentIds)
      );
    }

    function isParentAccount() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }

    // Registrations Collections (RBAC: Education / HR Admin + Self-lookup by verified email)
    match /student_registrations/{id} {
      allow create: if isValidId(id) && incoming().fullName is string && incoming().emailAddress is string && incoming().consentAccepted == true;
      allow get: if isValidId(id) && (isEducationAdmin() || (isSignedIn() && resource.data.emailAddress == request.auth.token.email));
      allow list: if isEducationAdmin() || isLmsTeacher() || (isSignedIn() && resource.data.emailAddress == request.auth.token.email);
      allow update, delete: if isValidId(id) && isEducationAdmin();
    }

    match /teacher_registrations/{id} {
      allow create: if isValidId(id) && incoming().fullName is string && incoming().email is string && incoming().consentAccepted == true;
      allow get: if isValidId(id) && (isEducationAdmin() || isHRAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email));
      allow list: if isEducationAdmin() || isHRAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow update, delete: if isValidId(id) && (isEducationAdmin() || isHRAdmin());
    }

    match /job_applications/{id} {
      allow create: if isValidId(id) && incoming().fullName is string && incoming().email is string && incoming().phone is string && incoming().consentAccepted == true;
      allow read, update, delete: if isHRAdmin();
    }

    match /internship_applications/{id} {
      allow create: if isValidId(id) && incoming().fullName is string && incoming().emailAddress is string && incoming().consentAccepted == true;
      allow read, update, delete: if isHRAdmin() || isEducationAdmin();
    }

    match /professional_registrations/{id} {
      allow create: if isValidId(id) && incoming().fullName is string && incoming().emailAddress is string && incoming().consentAccepted == true;
      allow read, update, delete: if isHRAdmin() || isSalesAdmin();
    }

    // ====================================================
    // Partnerships Collections (RBAC: Sales Admin, Super Admin)
    // ====================================================

    match /school_partnership_enquiries/{id} {
      allow create: if isValidId(id) && incoming().organizationName is string && incoming().emailAddress is string && incoming().consentAccepted == true;
      allow read, update, delete: if isSalesAdmin() || isEducationAdmin();
    }

    match /ngo_partnership_enquiries/{id} {
      allow create: if isValidId(id) && incoming().organizationName is string && incoming().emailAddress is string && incoming().consentAccepted == true;
      allow read, update, delete: if isSalesAdmin() || isHopeNestAdmin();
    }

    match /general_work_enquiries/{id} {
      allow create: if isValidId(id) && incoming().fullName is string && incoming().emailAddress is string && incoming().consentAccepted == true;
      allow read, update, delete: if isHRAdmin() || isSalesAdmin();
    }

    // ====================================================
    // HopeNest Foundation Collections (RBAC: HopeNest Admin)
    // ====================================================

    match /hopenest_volunteers/{id} {
      allow create: if isValidId(id) && incoming().fullName is string && incoming().emailAddress is string && incoming().consentAccepted == true;
      allow read, update, delete: if isHopeNestAdmin();
    }

    match /hopenest_donation_enquiries/{id} {
      allow create: if isValidId(id) && incoming().fullName is string && incoming().emailAddress is string && incoming().consentAccepted == true;
      allow read, update, delete: if isHopeNestAdmin();
    }

    match /hopenest_participants/{id} {
      allow create: if isValidId(id) && incoming().fullName is string && incoming().consentAccepted == true;
      allow read, update, delete: if isHopeNestAdmin();
    }

    match /ngo_updates/{id} {
      allow read: if isValidId(id);
      allow create, update, delete: if isValidId(id) && isHopeNestAdmin();
    }

    // ====================================================
    // Website Content & Settings (RBAC: Content Admin)
    // ====================================================

    match /blog_posts/{id} {
      allow read: if isValidId(id);
      allow create, update, delete: if isValidId(id) && isContentAdmin();
    }

    match /announcements/{id} {
      allow read: if isValidId(id);
      allow create, update, delete: if isValidId(id) && isContentAdmin();
    }

    match /branches/{id} {
      allow read: if isValidId(id);
      allow create, update, delete: if isValidId(id) && isContentAdmin();
    }

    match /courses/{id} {
      allow get: if isValidId(id) && (isContentAdmin() || isEducationAdmin() || isAdmin() || isLmsTeacher() || resource == null || resource.data.status == 'Published');
      allow list: if isContentAdmin() || isEducationAdmin() || isAdmin() || isLmsTeacher() || resource.data.status == 'Published';
      allow create, update: if isValidId(id) && (
        isContentAdmin() ||
        isEducationAdmin() ||
        isAdmin()
      ) && isValidCourse(incoming());
      allow delete: if isValidId(id) && (isContentAdmin() || isEducationAdmin() || isSuperAdmin());
    }

    match /products/{id} {
      allow read: if isValidId(id);
      allow create, update, delete: if isValidId(id) && isContentAdmin();
    }

    match /website_settings/{id} {
      allow read: if isValidId(id);
      allow create, update, delete: if isValidId(id) && isSuperAdmin();
    }

    match /newsletter_subscribers/{id} {
      allow create: if isValidId(id) && isValidSubscriber(incoming());
      allow read, update, delete: if isContentAdmin() || isSalesAdmin();
    }

    // ====================================================
    // Administration (RBAC: Only Super Admin)
    // ====================================================

    match /admin_users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create, update, delete: if isSuperAdmin();
    }

    match /activity_logs/{id} {
      allow read: if isAdmin() || isLmsTeacher();
      allow create: if isSignedIn() && isValidId(id);
      allow update, delete: if false; // Immutable audit log
    }

    // ====================================================
    // LMS COLLECTIONS (22+ Relational Entities with RBAC)
    // ====================================================

    match /users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isLmsEducatorOrAdmin());
      allow list: if isLmsEducatorOrAdmin();
      allow create: if isValidId(uid) && (
        isAdmin() ||
        (isOwner(uid) &&
          incoming().uid == request.auth.uid &&
          incoming().email is string && incoming().email.size() <= 120 &&
          incoming().displayName is string && incoming().displayName.size() <= 120 &&
          incoming().role in ['student', 'teacher', 'parent', 'institution_admin', 'field_executive', 'ngo_partner', 'professional'] &&
          incoming().roles is list && incoming().roles.size() >= 1 && incoming().roles.size() <= 2 &&
          (!('status' in incoming()) || incoming().status == 'active'))
      );
      allow update: if isValidId(uid) && (
        isAdmin() ||
        (isOwner(uid) &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role &&
          incoming().roles == existing().roles &&
          (!('status' in existing()) || incoming().status == existing().status) &&
          (!('approvalStatus' in existing()) || incoming().approvalStatus == existing().approvalStatus) &&
          incoming().createdAt == existing().createdAt &&
          (!('institutionId' in existing()) || existing().institutionId == null || existing().institutionId == '' || incoming().institutionId == existing().institutionId) &&
          incoming().role in ['student', 'teacher', 'parent', 'institution_admin', 'field_executive', 'ngo_partner', 'professional'])
      );
      allow delete: if isValidId(uid) && isAdmin();
    }

    match /student_profiles/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isLmsEducatorOrAdmin() || isLinkedParent(uid) || (isSignedIn() && resource.data.parentEmail == request.auth.token.email));
      allow list: if isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.parentEmail == request.auth.token.email || isParentAccount()));
      allow create, update: if isValidId(uid) && (isOwner(uid) || isLmsEducatorOrAdmin()) &&
        incoming().uid is string && incoming().uid.size() <= 128 &&
        incoming().fullName is string && incoming().fullName.size() <= 120 &&
        (!('homeAddress' in incoming()) || (incoming().homeAddress is string && incoming().homeAddress.size() <= 300)) &&
        (!('flatNumber' in incoming()) || (incoming().flatNumber is string && incoming().flatNumber.size() <= 60)) &&
        (!('streetAddress' in incoming()) || (incoming().streetAddress is string && incoming().streetAddress.size() <= 240)) &&
        (!('pincode' in incoming()) || (incoming().pincode is string && incoming().pincode.size() <= 12)) &&
        (!('mobileNumber' in incoming()) || (incoming().mobileNumber is string && incoming().mobileNumber.size() <= 20)) &&
        (!('alternativeMobileNumber' in incoming()) || (incoming().alternativeMobileNumber is string && incoming().alternativeMobileNumber.size() <= 20)) &&
        (!('state' in incoming()) || (incoming().state is string && incoming().state.size() <= 80));
      allow delete: if isValidId(uid) && isAdmin();
    }

    match /teacher_profiles/{uid} {
      allow get: if isValidId(uid) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(uid) && (isOwner(uid) || isEducationAdmin() || isAdmin()) &&
        incoming().uid is string && incoming().uid.size() <= 128 &&
        incoming().fullName is string && incoming().fullName.size() <= 120;
      allow delete: if isValidId(uid) && isAdmin();
    }

    match /parent_links/{id} {
      allow get: if isValidId(id) && (isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.studentUid == request.auth.uid)));
      allow list: if isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.parentUid == request.auth.uid || resource.data.studentUid == request.auth.uid));
      allow create: if isValidId(id) && isSignedIn() &&
        (incoming().parentUid == request.auth.uid || isAdmin()) &&
        incoming().studentUid is string && incoming().studentUid.size() <= 128;
      allow update, delete: if isValidId(id) && (isAdmin() || (isSignedIn() && resource.data.parentUid == request.auth.uid));
    }

    match /course_enrollments/{id} {
      allow get: if isValidId(id) && (isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || isLinkedParent(resource.data.studentId))));
      allow list: if isLmsEducatorOrAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isValidId(id) && isSignedIn() &&
        (incoming().studentId == request.auth.uid || isLmsEducatorOrAdmin()) &&
        incoming().courseId is string && incoming().courseId.size() <= 128 &&
        incoming().status in ['Submitted', 'Pending Verification', 'Verified', 'Pending Payment', 'Payment Completed', 'Approved', 'Rejected', 'Cancelled', 'Active', 'Completed', 'Suspended'] &&
        (!('homeAddress' in incoming()) || (incoming().homeAddress is string && incoming().homeAddress.size() <= 300)) &&
        (!('flatNumber' in incoming()) || (incoming().flatNumber is string && incoming().flatNumber.size() <= 60)) &&
        (!('streetAddress' in incoming()) || (incoming().streetAddress is string && incoming().streetAddress.size() <= 240)) &&
        (!('pincode' in incoming()) || (incoming().pincode is string && incoming().pincode.size() <= 12)) &&
        (!('mobileNumber' in incoming()) || (incoming().mobileNumber is string && incoming().mobileNumber.size() <= 20)) &&
        (!('alternativeMobileNumber' in incoming()) || (incoming().alternativeMobileNumber is string && incoming().alternativeMobileNumber.size() <= 20)) &&
        (!('state' in incoming()) || (incoming().state is string && incoming().state.size() <= 80)) &&
        (isLmsEducatorOrAdmin() || (
          !('adminApprovedBy' in incoming()) &&
          !('adminApprovedAt' in incoming()) &&
          !('adminReviewNote' in incoming()) &&
          (!('certificateApprovalStatus' in incoming()) || incoming().certificateApprovalStatus in ['Not Requested', 'Pending Admin Approval'])
        )) &&
        (!('paymentStatus' in incoming()) || incoming().paymentStatus != 'Paid' || isSuperAdmin() || (
          incoming().razorpayPaymentId is string &&
          incoming().razorpayPaymentId.size() >= 6 &&
          incoming().verifiedServerSide == true
        ));
      allow update: if isValidId(id) && (
        isSuperAdmin() ||
        (
          isLmsEducatorOrAdmin() &&
          !incoming().diff(existing()).affectedKeys().hasAny(['paymentStatus', 'feeAmount', 'razorpayOrderId', 'razorpayPaymentId', 'verifiedServerSide']) &&
          incoming().studentId == existing().studentId &&
          incoming().courseId == existing().courseId &&
          (!('certificateApprovalStatus' in incoming()) || incoming().certificateApprovalStatus in ['Not Requested', 'Pending Admin Approval', 'Approved', 'Revision Requested', 'Revoked']) &&
          (!('adminReviewNote' in incoming()) || (incoming().adminReviewNote is string && incoming().adminReviewNote.size() <= 600))
        ) ||
        (
          isSignedIn() &&
          existing().studentId == request.auth.uid &&
          !incoming().diff(existing()).affectedKeys().hasAny(['paymentStatus', 'feeAmount', 'razorpayOrderId', 'razorpayPaymentId', 'verifiedServerSide', 'adminApprovedBy', 'adminApprovedAt', 'adminReviewNote']) &&
          (!('certificateApprovalStatus' in incoming()) || incoming().certificateApprovalStatus in ['Not Requested', 'Pending Admin Approval'] || ('certificateApprovalStatus' in existing() && incoming().certificateApprovalStatus == existing().certificateApprovalStatus)) &&
          incoming().studentId == existing().studentId &&
          incoming().courseId == existing().courseId &&
          (!('homeAddress' in incoming()) || (incoming().homeAddress is string && incoming().homeAddress.size() <= 300)) &&
          (!('flatNumber' in incoming()) || (incoming().flatNumber is string && incoming().flatNumber.size() <= 60)) &&
          (!('streetAddress' in incoming()) || (incoming().streetAddress is string && incoming().streetAddress.size() <= 240)) &&
          (!('pincode' in incoming()) || (incoming().pincode is string && incoming().pincode.size() <= 12)) &&
          (!('mobileNumber' in incoming()) || (incoming().mobileNumber is string && incoming().mobileNumber.size() <= 20)) &&
          (!('alternativeMobileNumber' in incoming()) || (incoming().alternativeMobileNumber is string && incoming().alternativeMobileNumber.size() <= 20)) &&
          (!('state' in incoming()) || (incoming().state is string && incoming().state.size() <= 80))
        )
      );
      allow delete: if isValidId(id) && isSuperAdmin();
    }

    match /course_modules/{id} {
      allow read: if isValidId(id);
      allow create, update, delete: if isValidId(id) && isLmsEducatorOrAdmin();
    }

    match /lessons/{id} {
      allow read: if isValidId(id);
      allow create, update, delete: if isValidId(id) && isLmsEducatorOrAdmin();
    }

    match /youtube_recommendations/{id} {
      allow read: if isSignedIn();
      allow create, update: if isValidId(id) && isSignedIn();
      allow delete: if isValidId(id) && isAdmin();
    }

    match /video_learning_sessions/{id} {
      allow get: if isValidId(id) && (isLmsEducatorOrAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid));
      allow list: if isLmsEducatorOrAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create, update: if isValidId(id) && isSignedIn() &&
        (incoming().studentId == request.auth.uid || isLmsEducatorOrAdmin()) &&
        incoming().courseId is string && incoming().courseId.size() <= 128 &&
        incoming().videoId is string && incoming().videoId.size() <= 60;
      allow delete: if isValidId(id) && isAdmin();
    }

    match /lesson_completions/{id} {
      allow get: if isValidId(id) && (isLmsEducatorOrAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid));
      allow list: if isLmsEducatorOrAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create, update: if isValidId(id) && isSignedIn() &&
        (incoming().studentId == request.auth.uid || isLmsEducatorOrAdmin());
      allow delete: if isValidId(id) && isAdmin();
    }

    match /quizzes/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isValidId(id) && isLmsEducatorOrAdmin();
    }

    match /quiz_questions/{id} {
      allow read: if isSignedIn();
      allow create, update: if isValidId(id) && isSignedIn();
      allow delete: if isValidId(id) && isLmsEducatorOrAdmin();
    }

    match /quiz_attempts/{id} {
      allow get: if isValidId(id) && (isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || isLinkedParent(resource.data.studentId))));
      allow list: if isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || isLinkedParent(resource.data.studentId)));
      allow create: if isValidId(id) && isSignedIn() &&
        (incoming().studentId == request.auth.uid || isLmsEducatorOrAdmin()) &&
        incoming().courseId is string && incoming().courseId.size() <= 128 &&
        incoming().percentageScore is number;
      allow update, delete: if isValidId(id) && isAdmin();
    }

    match /quiz_responses/{id} {
      allow get: if isValidId(id) && (isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || isLinkedParent(resource.data.studentId))));
      allow list: if isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || isLinkedParent(resource.data.studentId)));
      allow create: if isValidId(id) && isSignedIn() &&
        (incoming().studentId == request.auth.uid || isLmsEducatorOrAdmin());
      allow update, delete: if isValidId(id) && isAdmin();
    }

    match /projects/{id} {
      allow get: if isValidId(id) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(id) && isSignedIn();
      allow delete: if isValidId(id) && isLmsEducatorOrAdmin();
    }

    match /project_submissions/{id} {
      allow get: if isValidId(id) && (isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || isLinkedParent(resource.data.studentId))));
      allow list: if isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || isLinkedParent(resource.data.studentId)));
      allow create: if isValidId(id) && isSignedIn() &&
        incoming().studentId == request.auth.uid &&
        incoming().courseId is string && incoming().courseId.size() <= 128;
      allow update: if isValidId(id) && (
        isLmsEducatorOrAdmin() ||
        (isSignedIn() && resource.data.studentId == request.auth.uid && existing().status != 'Approved')
      );
      allow delete: if isValidId(id) && isAdmin();
    }

    match /presentations/{id} {
      allow get: if isValidId(id) && (isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || isLinkedParent(resource.data.studentId))));
      allow list: if isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || isLinkedParent(resource.data.studentId)));
      allow create: if isValidId(id) && isSignedIn() &&
        incoming().studentId == request.auth.uid &&
        incoming().courseId is string && incoming().courseId.size() <= 128;
      allow update: if isValidId(id) && (
        isLmsEducatorOrAdmin() ||
        (isSignedIn() && resource.data.studentId == request.auth.uid)
      );
      allow delete: if isValidId(id) && isAdmin();
    }

    match /teacher_evaluations/{id} {
      allow get: if isValidId(id) && (isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || isLinkedParent(resource.data.studentId))));
      allow list: if isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || isLinkedParent(resource.data.studentId)));
      allow create, update: if isValidId(id) && isLmsEducatorOrAdmin() &&
        incoming().studentId is string && incoming().studentId.size() <= 128 &&
        incoming().totalScore is number;
      allow delete: if isValidId(id) && isAdmin();
    }

    match /certificates/{certId} {
      // Owner/Parent/Educator/Admin access only (stores private residential dispatch address & mobile numbers);
      // Public QR verification reads PII-free certificate_verification/{certId}.
      allow get: if isValidId(certId) && (isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || isLinkedParent(resource.data.studentId))));
      allow list: if isLmsEducatorOrAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || isLinkedParent(resource.data.studentId)));
      allow create: if isValidId(certId) && (
        isLmsEducatorOrAdmin() ||
        (isSignedIn() &&
          incoming().studentId == request.auth.uid &&
          incoming().certificateId is string && incoming().certificateId.size() <= 80 &&
          incoming().courseId is string && incoming().courseId.size() <= 128 &&
          incoming().status == 'Pending Admin Approval' &&
          (!('approvedByAdmin' in incoming()) || incoming().approvedByAdmin == false) &&
          !('adminApproverEmail' in incoming()) &&
          !('adminReviewNote' in incoming()) &&
          !('reviewedAt' in incoming()) &&
          (!('homeAddress' in incoming()) || (incoming().homeAddress is string && incoming().homeAddress.size() <= 300)) &&
          (!('flatNumber' in incoming()) || (incoming().flatNumber is string && incoming().flatNumber.size() <= 60)) &&
          (!('streetAddress' in incoming()) || (incoming().streetAddress is string && incoming().streetAddress.size() <= 240)) &&
          (!('pincode' in incoming()) || (incoming().pincode is string && incoming().pincode.size() <= 12)) &&
          (!('mobileNumber' in incoming()) || (incoming().mobileNumber is string && incoming().mobileNumber.size() <= 20)) &&
          (!('alternativeMobileNumber' in incoming()) || (incoming().alternativeMobileNumber is string && incoming().alternativeMobileNumber.size() <= 20)) &&
          (!('state' in incoming()) || (incoming().state is string && incoming().state.size() <= 80)))
      );
      allow update: if isValidId(certId) && (
        (isLmsEducatorOrAdmin() &&
          incoming().certificateId is string && incoming().certificateId.size() <= 80 &&
          incoming().studentId is string && incoming().studentId.size() <= 128 &&
          incoming().status in ['Pending Admin Approval', 'Issued', 'Revision Requested', 'Revoked', 'VERIFIED'] &&
          (!('adminReviewNote' in incoming()) || (incoming().adminReviewNote is string && incoming().adminReviewNote.size() <= 600))) ||
        (isSignedIn() &&
          existing().studentId == request.auth.uid &&
          existing().status in ['Pending Admin Approval', 'Revision Requested'] &&
          incoming().studentId == existing().studentId &&
          incoming().courseId == existing().courseId &&
          incoming().certificateId == existing().certificateId &&
          incoming().status == 'Pending Admin Approval' &&
          (!('approvedByAdmin' in incoming()) || incoming().approvedByAdmin == false) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['adminApproverEmail', 'adminReviewNote', 'reviewedAt']) &&
          (!('homeAddress' in incoming()) || (incoming().homeAddress is string && incoming().homeAddress.size() <= 300)) &&
          (!('flatNumber' in incoming()) || (incoming().flatNumber is string && incoming().flatNumber.size() <= 60)) &&
          (!('streetAddress' in incoming()) || (incoming().streetAddress is string && incoming().streetAddress.size() <= 240)) &&
          (!('pincode' in incoming()) || (incoming().pincode is string && incoming().pincode.size() <= 12)) &&
          (!('mobileNumber' in incoming()) || (incoming().mobileNumber is string && incoming().mobileNumber.size() <= 20)) &&
          (!('alternativeMobileNumber' in incoming()) || (incoming().alternativeMobileNumber is string && incoming().alternativeMobileNumber.size() <= 20)) &&
          (!('state' in incoming()) || (incoming().state is string && incoming().state.size() <= 80)))
      );
      allow delete: if isValidId(certId) && isAdmin();
    }

    match /certificate_verifications/{id} {
      allow create: if isValidId(id) && incoming().certificateId is string && incoming().certificateId.size() <= 80;
      allow read: if isAdmin() || isLmsTeacher();
      allow update, delete: if false;
    }

    match /certificate_verification/{certId} {
      // Minimal public QR verification lookup; zero private residential or contact PII allowed.
      // Only authorized admins, educators, or approved institution owners may publish or revoke public credentials.
      allow get: if isValidId(certId);
      allow list: if isLmsEducatorOrAdmin() || isEducationAdmin() || isAdmin();
      allow create, update: if isValidId(certId) &&
        incoming().certificateId is string && incoming().certificateId.size() <= 80 &&
        !('studentEmail' in incoming()) &&
        !('studentPhone' in incoming()) &&
        !('mobileNumber' in incoming()) &&
        !('alternativeMobileNumber' in incoming()) &&
        !('address' in incoming()) &&
        !('homeAddress' in incoming()) &&
        !('flatNumber' in incoming()) &&
        !('streetAddress' in incoming()) &&
        !('pincode' in incoming()) &&
        !('parentMobile' in incoming()) &&
        (
          isLmsEducatorOrAdmin() ||
          isEducationAdmin() ||
          isAdmin() ||
          (isSignedIn() && incoming().institutionId is string && isApprovedInstitutionOwner(incoming().institutionId))
        );
      allow delete: if isValidId(certId) && isAdmin();
    }

    match /notifications/{id} {
      allow get: if isValidId(id) && (isAdmin() || (isSignedIn() && (resource.data.recipientId == request.auth.uid || resource.data.recipientId == request.auth.token.email)));
      allow list: if isAdmin() || (isSignedIn() && (resource.data.recipientId == request.auth.uid || resource.data.recipientId == request.auth.token.email));
      allow create: if isValidId(id) && isSignedIn() &&
