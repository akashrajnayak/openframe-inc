          !incoming().diff(existing()).affectedKeys().hasAny(['teacherApproved', 'adminCertificateApproved', 'certificateIssued']))
      );
      allow delete: if isValidId(id) && isAdmin();
    }

    match /lms_settings/{id} {
      allow read: if isValidId(id) && isSignedIn();
      allow create, update, delete: if isValidId(id) && isAdmin();
    }

    match /certificate_templates/{id} {
