    match /marketplace_stats/{id} {
      allow get: if isValidId(id);
      allow list: if isContentAdmin() || isEducationAdmin() || isAdmin();
      allow create, update: if isValidId(id) && (
        isContentAdmin() ||
        isEducationAdmin() ||
        isAdmin()
      );
      allow delete: if false;
    }

    match /student_favorites/{id} {
      allow get: if isValidId(id) && (
        isLmsEducatorOrAdmin() ||
        (isSignedIn() && (id.matches('^' + request.auth.uid + '_.*') || (resource != null && resource.data.studentId == request.auth.uid)))
      );
      allow list: if isLmsEducatorOrAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isValidId(id) && isSignedIn() &&
        incoming().studentId == request.auth.uid &&
        incoming().courseId is string && incoming().courseId.size() <= 128 &&
        incoming().courseTitle is string && incoming().courseTitle.size() <= 300;
      allow update, delete: if isValidId(id) && (
